rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // 물건 사진: 누구나 읽기, 로그인 사용자 업로드 (이미지·5MB 이하)
    match /items/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // 일자리 사진: items와 동일한 규칙 (누락되어 업로드가 차단 상태였음)
    match /jobs/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // 공지/행사 포스터: 누구나 읽기, 어드민만 업로드·삭제 (이미지·5MB 이하)
    // 어드민 여부는 Firestore users/{uid}.isAdmin 으로 확인 (교차 서비스 규칙)
    match /announcements/{allPaths=**} {
      allow read: if true;
      allow create, update: if request.auth != null
                   && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.isAdmin == true
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null
                   && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // 나머지 경로는 전부 차단
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
